# Where the app finds the MyRoute API (the Express server in `backend/`).
#
# Leave this EMPTY in development. The app then derives the address from the
# dev server that delivered it: Metro proxies /api to the backend, so a phone
# on Wi-Fi, USB (adb reverse), an emulator or a tunnel reaches the backend over
# exactly the route the bundle already travels. No firewall rule, no LAN IP,
# no second port.
#
# Set it ONLY for production/preview builds, to the deployed backend:
#   EXPO_PUBLIC_API_URL=https://<your-deployed-backend>
EXPO_PUBLIC_API_URL=
